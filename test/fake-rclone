#!/bin/bash
# Local-directory stand-in for rclone, used by the tests: remote "<r>:/p" maps to $FAKE_CLOUD/<r>/p.
# Supports the few commands and flags the scripts use: copy (with --files-from-raw, --dry-run) and lsf -R --files-only --format tsp.
# FAKE_FAIL=lsf|copy-album makes that call exit 1.
map() { if [[ $1 == *:/* ]]; then echo "$FAKE_CLOUD/${1%%:*}/${1#*:/}"; else echo "$1"; fi; }
cmd=$1; shift; pos=(); ff=""; dry=false
while [ $# -gt 0 ]; do case $1 in
  --files-from-raw) ff=$2; shift 2;; --dry-run) dry=true; shift;; --progress) shift;;
  --config|--transfers|--checkers|--retries|--low-level-retries|--log-file|--log-level|--format|--separator) shift 2;;
  -R|--files-only) shift;; *) pos+=("$1"); shift;; esac; done
src=$(map "${pos[0]}")
case $cmd in
  lsf) [ "${FAKE_FAIL:-}" = lsf ] && exit 1
    (cd "$src" && find . -type f -printf '%TY-%Tm-%Td %TH:%TM:%.2TS\t%s\t%P\n');;
  copy) dst=$(map "${pos[1]}"); [ "$dry" = true ] && exit 0
    if [ -n "$ff" ]; then [ "${FAKE_FAIL:-}" = copy-album ] && exit 1; list=$(cat "$ff"); else list=$(cd "$src" && find . -type f | sed 's|^\./||'); fi
    while IFS= read -r f; do [ -n "$f" ] || continue; mkdir -p "$dst/$(dirname "$f")"; cp -p "$src/$f" "$dst/$f"; done <<< "$list";;
esac

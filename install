#!/bin/bash
# Installs the `apple` command from this checkout. Safe to rerun: it upgrades.
# Uses uv or pipx when present; otherwise makes a private virtual environment and links `apple` into a bin directory.
# Environment: APPLE_HOME (default ~/.local/share/apple), APPLE_BIN_DIR (default ~/.local/bin), DRY_RUN=true to only show the plan.
# The whole script lives in main so bash has parsed all of it before running any of it.
main() {
  local here home bin python dry=false method
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  home=${APPLE_HOME:-$HOME/.local/share/apple}
  bin=${APPLE_BIN_DIR:-$HOME/.local/bin}
  case ${DRY_RUN:-false} in [Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]|[Oo][Nn]) dry=true;; esac

  say() { echo "$*"; }
  run() { say "+ $*"; if [ "$dry" = false ]; then "$@"; fi; }

  # The newest python3 that is 3.9 or later
  python=
  for candidate in python3.13 python3.12 python3.11 python3.10 python3.9 python3; do
    if command -v "$candidate" >/dev/null && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
      python=$candidate; break
    fi
  done
  if [ -z "$python" ]; then
    echo "Python 3.9 or later is required. Install it with:" >&2
    if command -v brew >/dev/null; then echo "  brew install python" >&2
    elif command -v apt-get >/dev/null; then echo "  sudo apt-get install -y python3 python3-venv" >&2
    elif command -v dnf >/dev/null; then echo "  sudo dnf install -y python3" >&2
    elif command -v apk >/dev/null; then echo "  sudo apk add python3" >&2
    else echo "  (install Python 3.9+ from python.org, or on a Synology the Python 3 package in Package Center)" >&2
    fi
    return 2
  fi

  if command -v uv >/dev/null; then
    method=uv
    run uv tool install --force "$here" || return 1
  elif command -v pipx >/dev/null; then
    method=pipx
    run pipx install --force "$here" || return 1
  else
    method=venv
    if ! run "$python" -m venv "$home"; then
      echo "Could not create a virtual environment. On Debian or Ubuntu install the venv module with:" >&2
      echo "  sudo apt-get install -y python3-venv" >&2
      return 2
    fi
    run "$home/bin/pip" install --upgrade "$here" || return 1
    run mkdir -p "$bin"
    run ln -sf "$home/bin/apple" "$bin/apple"
  fi

  if [ "$dry" = true ]; then say "Dry run (via $method): nothing was installed."; return 0; fi
  if ! command -v apple >/dev/null && [ ! -x "$bin/apple" ]; then
    echo "Installed, but the apple command was not found. Add its directory to PATH:" >&2
    echo "  export PATH=\"$bin:\$PATH\"" >&2
    return 1
  fi
  say "Installed apple (via $method): $("${bin}/apple" --version 2>/dev/null || apple --version)"
  case ":$PATH:" in *":$bin:"*) ;; *) say "Add $bin to your PATH: export PATH=\"$bin:\$PATH\"" ;; esac
  say "Next: apple doctor"
}

main "$@"; exit

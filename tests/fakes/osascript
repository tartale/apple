#!/usr/bin/env python3
"""Stands in for osascript. Logs each call as JSON to $FAKE_OSASCRIPT_LOG and answers from the environment:
FAKE_LIBRARIES (name<TAB>path lines), FAKE_COPY_ERROR (stderr text; exits 1), FAKE_COPY_FOUND (the count)."""
import json
import os
import sys
from pathlib import Path

script, *args = sys.argv[1:]
name = Path(script).name
with open(os.environ["FAKE_OSASCRIPT_LOG"], "a") as log:
    log.write(json.dumps([name, *args]) + "\n")
if name == "libraries.applescript":
    print(os.environ.get("FAKE_LIBRARIES", ""))
elif name == "copy-photos.applescript":
    if os.environ.get("FAKE_COPY_ERROR"):
        print(os.environ["FAKE_COPY_ERROR"], file=sys.stderr)
        sys.exit(1)
    print("found " + os.environ.get("FAKE_COPY_FOUND", "3"))

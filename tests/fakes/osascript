#!/usr/bin/env python3
"""Stands in for osascript. Logs each call as JSON to $FAKE_OSASCRIPT_LOG (for copy-named.applescript the names file is
logged as the list of names it holds) and answers from the environment: FAKE_LIBRARIES (name<TAB>path lines),
FAKE_COPY_ERROR (stderr text; exits 1), FAKE_COPY_FOUND (the count), FAKE_NAMED_MISSING (comma-separated names that
copy-named.applescript reports as not in the source)."""
import json
import os
import sys
from pathlib import Path

script, *args = sys.argv[1:]
name = Path(script).name
if name == "copy-named.applescript":
    args[2] = Path(args[2]).read_text().splitlines()
with open(os.environ["FAKE_OSASCRIPT_LOG"], "a") as log:
    log.write(json.dumps([name, *args]) + "\n")
if name == "libraries.applescript":
    print(os.environ.get("FAKE_LIBRARIES", ""))
elif name in ("copy-photos.applescript", "copy-named.applescript"):
    if os.environ.get("FAKE_COPY_ERROR"):
        print(os.environ["FAKE_COPY_ERROR"], file=sys.stderr)
        sys.exit(1)
    for missing in filter(None, os.environ.get("FAKE_NAMED_MISSING", "").split(",")):
        print("missing\t" + missing)
    print("found " + os.environ.get("FAKE_COPY_FOUND", "3"))
